# ============================================================================
# Example environment file for the ML Platform.
# ----------------------------------------------------------------------------
# Copy this file to `.env` (git-ignored) and adjust values for your machine:
#
#     cp .env.example .env
#
# Note: Dynaconf is configured with `load_dotenv=True`, so a `.env` at the
# repo root is loaded automatically by `common_lib.config`. All values here
# are EXAMPLES — never commit real values (`.env`, `.env.*` are gitignored).
# ============================================================================

# --- Dynaconf application settings (APP_* prefix overrides settings.toml) ---
# Mirrors keys in settings.toml: [default] / [development] / [production].
# Format: APP_<KEY> where <KEY> is the lowercase settings key.

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
APP_LOG_LEVEL=info

# Logical service name used in structured logs and routing.
APP_SERVICE_NAME=ml-platform

# MLflow tracking URI used by training/export.
#   development: http://localhost:5000
#   production : https://mlflow.internal.example.com
APP_TRACKING_URI=http://localhost:5000

# --- Model artifact ------------------------------------------------------------------
# Path to the skops pipeline loaded by the serving API (api.runtime).
# Docker image default: /models/pipeline.skops
#   local dev (artifacts/latest symlink) e.g.:
#     MODEL_ARTIFACT_PATH=artifacts/latest/pipeline.skops
#   docker-compose passes:
#     MODEL_ARTIFACT_PATH=/models/latest/pipeline.skops
MODEL_ARTIFACT_PATH=artifacts/latest/pipeline.skops

# --- Settings file location (common_lib.config) ---------------------------------
# Optional override for the Dynaconf TOML file. Repo-root settings.toml is the
# default; override when running from a container without a repo checkout.
#   SETTINGS_FILE=/etc/config/settings.toml
# SETTINGS_FILE=settings.toml

# ============================================================================
# Make targets also honour these environment-overridable variables
# (equivalent to `make train ALPHA=0.5`). Used only by the CLI/Makefile.
# ============================================================================

# Port the serving API listens on (make serve / serve-prod).
#   PORT=8000

# Ridge regularization strength used at training time.
#   ALPHA=1.0

# Quality gate floor for test R^2 (0..1); training exits 2 below this.
#   MIN_R2=0.40

# Artifacts output directory for pipelines.export.
#   ARTIFACTS_DIR=artifacts

# Full path to the model for `make serve` (default: $(ARTIFACTS_DIR)/latest/...).
#   MODEL_PATH=artifacts/latest/pipeline.skops

# Docker image tag used by make docker-build / docker-run.
#   IMAGE=ml-platform/api:local

# ============================================================================
# CI/CD secret (GitHub Actions), NOT needed locally:
#   MLFLOW_TRACKING_URI  -> provided as secrets.MLFLOW_TRACKING_URI in CI
# ============================================================================